# Copiar a .env y completar. NUNCA subir .env al repositorio.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://postgres:postgres@localhost:5432/estropical_db
# Correo (en desarrollo se imprime en consola). TODO: configurar SMTP en producción
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Estropical <no-reply@estropical.local>
SITE_URL=http://localhost:8000
EMAIL_TIMEOUT=10
# En Render el plan gratuito bloquea los puertos SMTP 25/465/587.
# Define UNA de estas claves para enviar por API HTTPS (recomendado):
RESEND_API_KEY=
BREVO_API_KEY=
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_SENDER_DOMAIN=
CSRF_TRUSTED_ORIGINS=
