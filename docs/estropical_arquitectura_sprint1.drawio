          <mxGeometry x="280" y="285" width="720" height="60" as="geometry" />
        </mxCell>

        <mxCell id="middleware" value="Middleware&lt;br&gt;Security · Session · Common · CSRF · Authentication&lt;br&gt;LoginRequired (deny by default) · Messages · XFrame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
